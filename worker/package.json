{
  "name": "funkin-online-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute funkin-online-db --file=./migrations/0001_initial.sql",
    "db:seed": "wrangler d1 execute funkin-online-db --file=./migrations/0002_seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.100.0"
  },
  "dependencies": {
    "sanitize-html": "^2.13.0"
  },
  "allowScripts": {
    "esbuild@0.17.19": true,
    "workerd@1.20250718.0": true
  }
}
