{
  "name": "funkin-online-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "deploy": "node -e \"import('./deploy.mjs').then(m => m.deploy())\"",
    "setup": "node -e \"import('./deploy.mjs').then(m => m.setup())\"",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.100.0"
  },
  "dependencies": {
    "sanitize-html": "^2.13.0"
  },
  "allowScripts": {
    "esbuild@0.17.19": true,
    "workerd@1.20250718.0": true
  }
}
